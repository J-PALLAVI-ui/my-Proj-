# =====================================================================
# FujiNova — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env':
#      cp .env.example .env   (or Copy-Item .env.example .env on Windows)
# 2. Populate your authentic API keys below.
# 3. NEVER commit your actual '.env' file or paste credentials into chat/git.
# =====================================================================

# Server Environment
FUJINOVA_ENV=development
FUJINOVA_HOST=127.0.0.1
FUJINOVA_PORT=8000
DATABASE_URL=sqlite:///./fujinova.db

# ---------------------------------------------------------------------
# Real AI Provider Configuration (Phase 2 Requirement)
# ---------------------------------------------------------------------

# Primary Model Provider ('openai' or 'google')
FUJINOVA_PRIMARY_PROVIDER=openai

# OpenAI Official SDK Configuration
# Supported models include: gpt-4o, gpt-4o-mini, gpt-4.5-preview, o1, o3-mini
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=1500
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT_SECONDS=25.0
OPENAI_MAX_RETRIES=2

# Google AI Studio Configuration (Alternate / Failover Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Operational Safeguards
ENABLE_OPENAI_FALLBACK=true
ALLOW_MULTI_VENDOR_FAILOVER=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
